# LLM
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
INSURANCE_AGENT_MODEL=qwen3.7-plus
CRM_AGENT_MODEL=qwen3.7-plus
SIMPLE_AGENT_MODEL=anthropic:claude-sonnet-4-6

# MySQL business data
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=insurance_app
MYSQL_PASSWORD=
MYSQL_DATABASE=insurance

# PostgreSQL checkpoints and long-term store
POSTGRES_URI=postgresql://insurance_app:change-me@localhost:5432/insurance_agent
PG_PIPELINE=false

# Milvus online vector store
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=file_documents
MILVUS_USER=
MILVUS_PASSWORD=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
RAG_TOP_K=5
RAG_QUERY_COUNT=3

# OpenTelemetry
OTEL_SERVICE_NAME=insurance-agent-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=

# Agent runtime
AGENT_PROMPT_VERSION=v1
AGENT_MODEL_POLICY=balanced
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SECONDS=90
