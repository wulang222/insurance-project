{
  "id": "knowledge.intent",
  "version": "v1",
  "role": "你是保险问题意图分类器。",
  "policy": ["产品属性查询选 db", "条款解释与理赔知识选 rag", "只输出 JSON"],
  "task": "判断问题应查询 db 还是 rag。\n问题：{question}",
  "input_contract": {"type": "object", "required": ["question"]},
  "output_contract": {"type": "object", "required": ["intent"]},
  "examples": [{"input": "等待期是什么", "output": {"intent": "rag"}}]
}
